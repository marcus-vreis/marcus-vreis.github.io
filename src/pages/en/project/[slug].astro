---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import LocaleToggle from '../../../components/LocaleToggle.astro';
import { UI } from '../../../lib/ui-strings';
import { entriesFor, slugOf } from '../../../lib/projects';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entriesFor(entries, 'en').map((entry) => ({
    params: { slug: slugOf(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = UI.en;
const d = entry.data;
---

<Base
  title={`${d.title} — ${t.siteTitle}`}
  description={d.tagline}
  locale="en"
>
  <main>
    <article style={`--accent: light-dark(${d.accentLight}, ${d.accent})`}>
      <LocaleToggle current="en" pathname={Astro.url.pathname} />
      <p class="persona tabular">{d.persona}</p>
      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>

      <dl class="meta tabular">
        <dt>{t.yearLabel}</dt><dd>{d.year}</dd>
        <dt>{t.stackLabel}</dt><dd>{d.stack.join(' · ')}</dd>
      </dl>

      {d.cover && (
        <div class="figure">
          <Image src={d.cover} alt={d.coverAlt ?? ''} width={1200} format="webp" loading="lazy" decoding="async" />
        </div>
      )}

      <div class="prose"><Content /></div>

      {d.detailImage && (
        <div class="figure">
          <Image src={d.detailImage} alt={d.detailImageAlt ?? ''} width={1200} format="webp" loading="lazy" decoding="async" />
        </div>
      )}

      {(d.repo || d.links.length > 0) && (
        <ul class="links">
          {d.repo && <li><a href={d.repo}>{t.repoLabel}</a></li>}
          {d.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      )}

      <a class="back" href="/en/">← {t.backLabel}</a>
    </article>
  </main>
</Base>

<style>
  article {
    max-width: 42rem;
    margin-inline: auto;
    padding: 4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .persona {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 { font-size: clamp(2.5rem, 1.5rem + 4vw, 4.5rem); }
  .tagline { color: var(--muted); }

  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.5rem;
    font-size: 0.8125rem;
    margin: 0;
  }

  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; }

  .figure {
    border: 1px solid var(--rule);
    line-height: 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .prose { display: flex; flex-direction: column; gap: 1rem; }

  .links { display: flex; gap: 1rem; padding: 0; list-style: none; }
  .links a { border-bottom: 1px solid var(--accent); text-decoration: none; }

  .back { color: var(--muted); text-decoration: none; font-size: 0.875rem; }
</style>
