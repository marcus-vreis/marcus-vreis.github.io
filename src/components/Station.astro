---
import { Image } from 'astro:assets';

interface Props {
  slug: string;
  title: string;
  persona: string;
  tagline: string;
  accent: string;
  accentLight: string;
  year: string;
  stack: string[];
  href: string;
  /** Capa opcional da estação. Quando ausente, o texto ocupa a estação
   *  inteira em vez de deixar uma coluna vazia. */
  cover?: ImageMetadata;
  /** Obrigatório sempre que `cover` estiver presente — o schema de conteúdo
   *  garante o par, mas o componente não assume isso silenciosamente. */
  coverAlt?: string;
  /** Rótulos vêm do idioma da página — o componente é compartilhado. */
  yearLabel: string;
  stackLabel: string;
  readLabel: string;
}

const {
  slug, title, persona, tagline, accent, accentLight, year, stack, href, cover, coverAlt,
  yearLabel, stackLabel, readLabel,
} = Astro.props;

const hasCover = Boolean(cover && coverAlt);
---

<section
  id={slug}
  data-station
  data-accent={accent}
  data-accent-light={accentLight}
  aria-labelledby={`${slug}-title`}
  class:list={{ 'has-cover': hasCover }}
  style={`--accent: light-dark(${accentLight}, ${accent})`}
>
  <div class="frame">
    <div class="content">
      <p class="persona tabular">{persona}</p>
      <h2 id={`${slug}-title`}>{title}</h2>
      <p class="tagline">{tagline}</p>

      <dl class="meta tabular">
        <dt>{yearLabel}</dt><dd>{year}</dd>
        <dt>{stackLabel}</dt><dd>{stack.join(' · ')}</dd>
      </dl>

      <slot />

      <a class="read" href={href}>{readLabel}</a>
    </div>

    {hasCover && cover && (
      <div class="cover">
        <Image
          src={cover}
          alt={coverAlt as string}
          width={960}
          format="webp"
          quality={70}
          loading="lazy"
          decoding="async"
          fetchpriority="low"
        />
      </div>
    )}
  </div>
</section>

<style>
  section {
    border-top: 1px solid var(--rule);
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    padding-inline: 1.5rem;
    scroll-margin-top: 4rem;
  }

  .frame {
    /* Sem capa, a estação é uma coluna de leitura — a mesma largura do
       cabeçalho e da seção "sobre". Não reserva uma segunda coluna vazia. */
    max-width: 46rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(2rem, 4vw, 4rem);
  }

  section.has-cover .frame {
    /* Com capa, a estação ganha largura para acomodar as duas colunas. */
    max-width: 64rem;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
  }

  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .persona {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 { font-size: clamp(2.5rem, 1.5rem + 4vw, 5rem); }

  .tagline { color: var(--muted); max-width: 34rem; }

  .meta {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 1.5rem;
    font-size: 0.8125rem;
    margin: 0;
  }

  .meta dt { color: var(--muted); }
  .meta dd { margin: 0; }

  .read {
    align-self: start;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--accent);
    text-decoration: none;
    font-size: 0.875rem;
  }

  .cover {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule);
    line-height: 0;
  }

  .cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 40rem) {
    section.has-cover .frame {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // O gerente de estações vive em `src/lib/gl/station-controller.ts`, não
  // aqui. Este componente é usado dez vezes na página, mas Astro deduplica
  // o `<script>` de módulo — ele roda UMA vez para a página inteira, não
  // uma vez por estação — e o que roda aqui é só um carregador mínimo.
  //
  // Ele espera o evento `load` antes de sequer buscar o gerente: nenhuma
  // estação monta canvas antes de o visitante rolar até ela, então nada
  // aqui é crítico para a primeira pintura. Buscar o módulo do gerente (e
  // as dependências dele) mais cedo faria uma requisição a mais competir
  // pelas conexões com o CSS e as fontes bem no caminho crítico de
  // renderização — exatamente o tipo de coisa que derruba o LCP. Por isso
  // `import()` aqui é dinâmico e só dispara depois do `load`, em vez de um
  // `import` estático de topo, que o Astro buscaria imediatamente.
  function boot(): void {
    import('../lib/gl/station-controller').then((m) => m.bootStations());
  }

  if (document.readyState === 'complete') {
    boot();
  } else {
    window.addEventListener('load', boot, { once: true });
  }
</script>
