---
import type { IndexRow } from '../lib/index-rows';

interface Props {
  rows: IndexRow[];
  heading: string;
}

const { rows, heading } = Astro.props;
---

<section id="projetos" aria-labelledby="projetos-title">
  <h2 id="projetos-title">{heading}</h2>
  <ol>
    {rows.map((row) => (
      <li style={`--accent: light-dark(${row.accentLight}, ${row.accent})`}>
        <a href={row.href} data-slug={row.slug} data-mood={row.mood}>
          <span class="title">{row.title}</span>
          <span class="sep">{', '}</span>
          <span class="mood">{row.moodLabel}</span>
          <span class="sep">{', '}</span>
          <span class="detail tabular">{row.detail}</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  section {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 2rem + 3vw, 5rem) 1.5rem;
  }

  h2 {
    font-size: clamp(1.75rem, 1.25rem + 2vw, 2.75rem);
    margin-bottom: 1.5rem;
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  a {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem 17rem;
    gap: 1rem;
    align-items: baseline;
    padding: 0.875rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }

  a:hover .title,
  a:focus-visible .title {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .sep {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.375rem;
  }

  .mood {
    color: var(--accent);
    font-size: 0.8125rem;
  }

  /* O "pixel" antes do humor: mesmo quadrado das máquinas que vêm no Plano 4. */
  .mood::before {
    content: '';
    display: inline-block;
    width: 0.4375rem;
    height: 0.4375rem;
    margin-right: 0.5rem;
    background: var(--accent);
    vertical-align: 0.0625rem;
  }

  .detail {
    color: var(--muted);
    font-size: 0.8125rem;
    text-align: right;
  }

  @media (max-width: 40rem) {
    a {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .detail {
      grid-column: 1 / -1;
      text-align: left;
    }
  }
</style>
