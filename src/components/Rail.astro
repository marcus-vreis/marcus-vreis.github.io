---
interface Stop {
  slug: string;
  label: string;
}

interface Props {
  stops: Stop[];
  navLabel: string;
}

const { stops, navLabel } = Astro.props;
---

<nav class="rail" aria-label={navLabel}>
  <ol>
    {stops.map((stop, index) => (
      <li>
        <a href={`#${stop.slug}`} data-stop={stop.slug}>
          <span class="tick" aria-hidden="true"></span>
          <span class="index tabular">{String(index + 1).padStart(2, '0')}</span>
          <span class="label">{stop.label}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>

<style>
  .rail {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  ol {
    display: flex;
    gap: 0;
    margin: 0;
    padding: 0 1rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  a {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.75rem 0.875rem;
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.8125rem;
    color: var(--muted);
    transition: color 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  a:hover { color: var(--fg); }

  .tick {
    width: 1px;
    height: 0.5rem;
    background: var(--rule);
  }

  .index { color: var(--accent); }

  @media (max-width: 40rem) {
    .label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
