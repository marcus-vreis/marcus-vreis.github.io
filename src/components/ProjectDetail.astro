---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import LocaleToggle from './LocaleToggle.astro';
import Schematic from './Schematic.astro';
import { snapshot } from '../lib/github/load';
import { resolveMood } from '../lib/mood';
import { formatSince } from '../lib/relative-time';
import { buildPath, type Locale } from '../lib/i18n';
import { entriesFor, slugOf } from '../lib/projects';
import { UI, type CharacterId } from '../lib/ui-strings';

interface Props {
  entry: CollectionEntry<'projects'>;
  locale: Locale;
  pathname: string;
}

const { entry, locale, pathname } = Astro.props;
const { Content } = await render(entry);
const t = UI[locale];
const d = entry.data;

const character = (d.character as CharacterId | undefined) ?? 'nevoeiro';
const homeHref = buildPath({ kind: 'home' }, locale);

const repoSnap = d.github ? snapshot.repos[d.github] : undefined;
const moodInfo =
  d.status && repoSnap ? resolveMood(d.status, repoSnap, snapshot.generatedAt) : undefined;
const sinceText = moodInfo ? formatSince(moodInfo.daysSinceCommit, locale) : undefined;

const allLocale = entriesFor(await getCollection('projects'), locale);
const currentIndex = allLocale.findIndex((e) => e.id === entry.id);
const prevEntry = currentIndex > 0 ? allLocale[currentIndex - 1] : undefined;
const nextEntry =
  currentIndex >= 0 && currentIndex < allLocale.length - 1
    ? allLocale[currentIndex + 1]
    : undefined;
---

<main>
  <article
    class="spec-sheet"
    style={`--accent: light-dark(${d.accentLight}, ${d.accent})`}
  >
    <header class="sheet-topbar tabular">
      <a class="back" href={homeHref}>← {t.backLabel}</a>
      <LocaleToggle current={locale} pathname={pathname} />
    </header>

    <div class="sheet-hero">
      <div class="persona-row tabular">
        <p class="persona">{d.persona}</p>
        {moodInfo && <span class="mood-pill">{t.moods[moodInfo.mood]}</span>}
      </div>

      <h1>{d.title}</h1>
      <p class="tagline">{d.tagline}</p>

      {(d.repo || d.links.length > 0) && (
        <ul class="links tabular">
          {d.repo && (
            <li>
              <a href={d.repo}>{t.repoLabel} ↗</a>
            </li>
          )}
          {d.links.map((link) => (
            <li>
              <a href={link.href}>{link.label} ↗</a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <dl class="meta-grid tabular">
      <div class="meta-cell">
        <dt>{t.yearLabel}</dt>
        <dd>{d.year}</dd>
      </div>

      {moodInfo && sinceText && repoSnap && (
        <>
          <div class="meta-cell">
            <dt>{t.lastCommitLabel}</dt>
            <dd>{sinceText} ({repoSnap.lastCommitAt.slice(0, 10)})</dd>
          </div>
          <div class="meta-cell">
            <dt>{t.commits90dLabel}</dt>
            <dd>{repoSnap.commits90d} {t.commits90dSuffix}</dd>
          </div>
        </>
      )}

      {moodInfo?.versionBadge && (
        <div class="meta-cell">
          <dt>{t.releaseLabel}</dt>
          <dd class="accent-text">{moodInfo.versionBadge}</dd>
        </div>
      )}

      <div class="meta-cell meta-stack">
        <dt>{t.stackLabel}</dt>
        <dd>{d.stack.join(' · ')}</dd>
      </div>
    </dl>

    <section class="schematic-section" aria-label={t.schematicLabel}>
      <Schematic character={character} locale={locale} variant="detail" />
    </section>

    {d.cover && (
      <figure class="figure">
        <Image
          src={d.cover}
          alt={d.coverAlt ?? ''}
          width={1200}
          format="webp"
          loading="lazy"
          decoding="async"
        />
        {d.coverAlt && <figcaption class="tabular">{d.coverAlt}</figcaption>}
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    {d.detailImage && (
      <figure class="figure">
        <Image
          src={d.detailImage}
          alt={d.detailImageAlt ?? ''}
          width={1200}
          format="webp"
          loading="lazy"
          decoding="async"
        />
        {d.detailImageAlt && <figcaption class="tabular">{d.detailImageAlt}</figcaption>}
      </figure>
    )}

    <nav class="sheet-nav tabular" aria-label={t.projectsHeading}>
      {prevEntry ? (
        <a
          class="nav-card"
          href={buildPath({ kind: 'project', slug: slugOf(prevEntry.id) }, locale)}
        >
          <span class="nav-label">← {t.prevProjectLabel}</span>
          <span class="nav-title">{prevEntry.data.title}</span>
        </a>
      ) : (
        <a class="nav-card" href={homeHref}>
          <span class="nav-label">← {t.backLabel}</span>
          <span class="nav-title">{t.projectsHeading}</span>
        </a>
      )}

      {nextEntry && (
        <a
          class="nav-card nav-card--next"
          href={buildPath({ kind: 'project', slug: slugOf(nextEntry.id) }, locale)}
        >
          <span class="nav-label">{t.nextProjectLabel} →</span>
          <span class="nav-title">{nextEntry.data.title}</span>
        </a>
      )}
    </nav>
  </article>
</main>

<style>
  .spec-sheet {
    max-width: 58rem;
    margin-inline: auto;
    padding: clamp(2rem, 1.5rem + 3vw, 4rem) 1.5rem clamp(4rem, 3rem + 4vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .sheet-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
  }

  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8125rem;
  }

  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  .sheet-hero {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .persona-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .persona {
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .mood-pill {
    font-size: 0.75rem;
    padding: 0.1rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
    color: var(--accent);
  }

  h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.8vw, 4.25rem);
    line-height: 1.06;
  }

  .tagline {
    color: var(--muted);
    font-size: 1.125rem;
    max-width: 44rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding: 0;
    margin: 0.35rem 0 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
    color: var(--fg);
    font-size: 0.8125rem;
    text-decoration: none;
  }

  .links a:hover,
  .links a:focus-visible {
    background: color-mix(in srgb, var(--accent) 20%, var(--bg));
  }

  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 2%, var(--bg));
    margin: 0;
  }

  .meta-cell {
    padding: 0.75rem 1rem;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-stack {
    grid-column: 1 / -1;
    border-right: 0;
    border-bottom: 0;
  }

  .meta-cell dt {
    color: var(--muted);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .meta-cell dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--fg);
  }

  .accent-text {
    color: var(--accent);
    font-weight: 600;
  }

  .figure {
    margin: 0;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 2%, var(--bg));
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
  }

  .figure figcaption {
    padding: 0.65rem 0.9rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .sheet-nav {
    margin-top: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
  }

  .nav-card {
    border: 1px solid var(--rule);
    padding: 0.9rem 1.1rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    background: color-mix(in srgb, var(--fg) 1.5%, var(--bg));
  }

  .nav-card--next {
    text-align: right;
  }

  .nav-card:hover,
  .nav-card:focus-visible {
    border-color: var(--accent);
  }

  .nav-label {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .nav-title {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: 1.35rem;
    color: var(--fg);
  }
</style>
