---
import { parseInlineLinks } from '../lib/ui-strings';

interface Props {
  text: string;
}

const { text } = Astro.props;
const segments = parseInlineLinks(text);
---

{segments.map((seg) =>
  seg.href ? (
    <a
      class="inline-link"
      href={seg.href}
      target={seg.external ? '_blank' : undefined}
      rel={seg.external ? 'noopener noreferrer' : undefined}
    >{seg.text}</a>
  ) : (
    seg.text
  ),
)}

<style>
  .inline-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 75%, var(--rule));
    text-underline-offset: 0.2em;
    transition: color 140ms ease, text-decoration-color 140ms ease;
  }

  .inline-link:hover,
  .inline-link:focus-visible {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
