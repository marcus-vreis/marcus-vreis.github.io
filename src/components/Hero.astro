---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import ContactIcon from './ContactIcon.astro';
import InlineText from './InlineText.astro';
import LocaleToggle from './LocaleToggle.astro';
import type { Locale } from '../lib/i18n';
import { UI } from '../lib/ui-strings';

interface Props {
  locale: Locale;
  pathname: string;
  snapshotDate: string;
  totalCommits90d: number;
  activeCount: number;
  totalRepos: number;
  latestRelease: string;
  latestReleaseProject: string;
  latestReleaseHref: string;
}

const {
  locale,
  pathname,
  snapshotDate,
  totalCommits90d,
  activeCount,
  totalRepos,
  latestRelease,
  latestReleaseProject,
  latestReleaseHref,
} = Astro.props;
const t = UI[locale];
---

<header class="stage">
  <div class="topbar">
    <div class="topbar-inner">
      <span class="doc-badge tabular">{t.heroBadge}</span>
      <div class="topbar-actions">
        <nav class="section-nav tabular" aria-label={t.siteTitle}>
          <a href="#projetos">{t.navProjects}</a>
          <a href="#pesquisa">{t.navResearch}</a>
          <a href="#publicacoes">{t.navPublications}</a>
          <a href="#sobre">{t.navAbout}</a>
        </nav>

        <ul class="topbar-icons" aria-label={t.contactHeading}>
          {t.contact.map((item) => (
            <li>
              <a
                class="icon-btn"
                href={item.href}
                target={item.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                aria-label={`${item.label}: ${item.value}`}
                title={`${item.label} (${item.value})`}
              >
                <ContactIcon name={item.icon} />
              </a>
            </li>
          ))}
        </ul>

        <LocaleToggle current={locale} pathname={pathname} />
      </div>
    </div>
  </div>

  <div class="inner">
    <div class="copy">
      <div class="profile-hero">
        <figure class="portrait-card">
          <div class="portrait-frame">
            <Image
              src={portrait}
              alt={t.authorPhotoAlt}
              width={360}
              height={420}
              class="portrait-img"
              loading="eager"
            />
          </div>
          <figcaption class="portrait-caption tabular">
            <span>{t.citationShort}</span>
            <span>{t.birthAndNationality}</span>
          </figcaption>
        </figure>

        <div class="profile-identity">
          <p class="author-name">{t.fullName}</p>
          <ul class="role-list">
            <li class="role-primary">{t.heroRolePrimary}</li>
            <li class="role-secondary">{t.heroRoleSecondary}</li>
            <li class="role-degree">{t.heroDegreeLine}</li>
          </ul>
          <p class="location-line tabular">{t.locationLabel}</p>

          <ul class="area-tags tabular" aria-label={t.researchAreasLabel}>
            {t.researchAreas.map((area) => (
              <li>{area}</li>
            ))}
          </ul>
        </div>
      </div>

      <h1 class="thesis">{t.thesis}</h1>

      <div class="intro-prose">
        {t.intro.map((paragraph) => (
          <p class="intro">
            <InlineText text={paragraph} />
          </p>
        ))}
      </div>

      <ul class="hero-links tabular" aria-label={t.contactHeading}>
        {t.contact.map((item) => (
          <li>
            <a
              class="hero-link-pill"
              href={item.href}
              target={item.href.startsWith('mailto:') ? undefined : '_blank'}
              rel={item.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
            >
              <ContactIcon name={item.icon} />
              <span class="pill-label">{item.label}</span>
              <span class="pill-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <aside class="console" aria-label={t.portraitAlt}>
      <div class="telemetry-panel">
        <div class="panel-header tabular">
          <span class="panel-title">{t.telemetryHeading}</span>
          <span class="panel-stamp">{t.telemetrySnapshotLabel}: {snapshotDate}</span>
        </div>
        <dl class="telemetry-grid tabular">
          <div class="stat">
            <dt>{t.telemetryCommitsLabel}</dt>
            <dd class="stat-accent">{totalCommits90d}</dd>
          </div>
          <div class="stat">
            <dt>{t.telemetryActiveLabel}</dt>
            <dd>{activeCount} / {totalRepos}</dd>
          </div>
          <div class="stat">
            <dt>{t.telemetryReleaseLabel}</dt>
            <dd class="stat-release">
              {latestReleaseProject ? (
                <a class="stat-release-link" href={latestReleaseHref}>
                  <span class="stat-release-project">{latestReleaseProject}</span>
                  <span class="stat-accent">{latestRelease}</span>
                </a>
              ) : (
                <span>{latestRelease}</span>
              )}
            </dd>
          </div>
        </dl>
      </div>

      <div class="pillars-panel" data-pillars>
        <div class="panel-header tabular">
          <span class="panel-title">{t.pillarsHeading}</span>
          <div class="pillar-tabs" role="tablist" aria-label={t.pillarsHeading}>
            {t.pillars.map((pillar, idx) => (
              <button
                type="button"
                role="tab"
                class="pillar-tab tabular"
                aria-selected={idx === 0 ? 'true' : 'false'}
                data-pillar-tab={pillar.id}
              >
                0{idx + 1}
              </button>
            ))}
          </div>
        </div>

        <div class="pillar-list">
          {t.pillars.map((pillar, idx) => (
            <article
              class="pillar-card"
              data-pillar-panel={pillar.id}
              data-active={idx === 0 ? 'true' : 'false'}
            >
              <p class="pillar-code tabular">{pillar.code}</p>
              <h2 class="pillar-title">{pillar.title}</h2>
              <code class="pillar-formula">{pillar.formula}</code>
              <p class="pillar-summary">
                <InlineText text={pillar.summary} />
              </p>
              <ul class="pillar-projects tabular">
                {pillar.projectLinks.map((pl) => (
                  <li>
                    <a href={pl.href}>{pl.label} →</a>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </aside>
  </div>
</header>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-pillars]');
  for (const root of roots) {
    root.setAttribute('data-enhanced', 'true');
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-pillar-tab]');
    const panels = root.querySelectorAll<HTMLElement>('[data-pillar-panel]');
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-pillar-tab');
        for (const btn of tabs) {
          btn.setAttribute('aria-selected', String(btn === tab));
        }
        for (const panel of panels) {
          panel.setAttribute(
            'data-active',
            String(panel.getAttribute('data-pillar-panel') === target),
          );
        }
      });
    }
  }
</script>

<style>
  .stage {
    border-bottom: 1px solid var(--rule);
    background-image:
      radial-gradient(circle at 82% 22%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 45%),
      linear-gradient(to bottom, color-mix(in srgb, var(--fg) 2%, var(--bg)), var(--bg));
  }

  .topbar {
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 2%, var(--bg));
  }

  .topbar-inner {
    max-width: 76rem;
    margin-inline: auto;
    padding: 0.7rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .doc-badge {
    font-size: 0.75rem;
    letter-spacing: 0.09em;
    color: var(--accent);
    font-weight: 600;
  }

  .topbar-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.15rem;
  }

  .section-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8125rem;
  }

  .section-nav a {
    color: var(--muted);
    text-decoration: none;
  }

  .section-nav a:hover,
  .section-nav a:focus-visible {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.25em;
  }

  .topbar-icons {
    list-style: none;
    margin: 0;
    padding: 0 0.85rem;
    border-left: 1px solid var(--rule);
    border-right: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    color: var(--muted);
    border: 1px solid transparent;
    transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease;
  }

  .icon-btn:hover,
  .icon-btn:focus-visible {
    color: var(--accent);
    border-color: var(--rule);
    background: color-mix(in srgb, var(--fg) 4%, var(--bg));
  }

  .inner {
    max-width: 76rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 1.8rem + 3vw, 4.25rem) 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    align-items: start;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .profile-hero {
    display: grid;
    grid-template-columns: 10.75rem minmax(0, 1fr);
    gap: 1.35rem;
    align-items: start;
    padding-bottom: 1.35rem;
    border-bottom: 1px solid var(--rule);
  }

  .portrait-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .portrait-frame {
    width: 10.75rem;
    height: 12.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--rule));
    padding: 0.25rem;
    background: color-mix(in srgb, var(--fg) 3%, var(--bg));
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
    filter: contrast(1.04);
  }

  .portrait-caption {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    font-size: 0.65rem;
    color: var(--muted);
    letter-spacing: 0.03em;
  }

  .profile-identity {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-width: 0;
  }

  .author-name {
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2rem, 1.55rem + 1.6vw, 2.65rem);
    line-height: 1.06;
    color: var(--fg);
  }

  .role-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .role-primary {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .role-secondary {
    color: var(--fg);
    font-size: 0.875rem;
  }

  .role-degree {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  .location-line {
    font-size: 0.75rem;
    color: var(--muted);
  }

  .area-tags {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .area-tags li {
    font-size: 0.6875rem;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 3%, var(--bg));
    color: var(--fg);
  }

  .thesis {
    font-size: clamp(1.5rem, 1.25rem + 1.1vw, 2.05rem);
    line-height: 1.2;
    color: var(--fg);
  }

  .intro-prose {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .intro {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .hero-links {
    list-style: none;
    padding: 0;
    margin: 0.15rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .hero-link-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.38rem 0.68rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 2.5%, var(--bg));
    font-size: 0.75rem;
    color: var(--fg);
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, background-color 140ms ease;
  }

  .hero-link-pill:hover,
  .hero-link-pill:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, var(--bg));
  }

  .pill-arrow {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .console {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .telemetry-panel,
  .pillars-panel {
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 3%, var(--bg));
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 5%, var(--bg));
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel-title {
    color: var(--fg);
    font-weight: 600;
  }

  .panel-stamp {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .telemetry-grid {
    display: grid;
    grid-template-columns: 0.9fr 0.9fr 1.2fr;
    margin: 0;
  }

  .stat {
    padding: 0.85rem 1rem;
    border-right: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.25rem;
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat dt {
    color: var(--muted);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .stat dd {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--fg);
  }

  .stat .stat-accent {
    color: var(--accent);
  }

  .stat-release {
    font-size: 1rem;
  }

  .stat-release-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
  }

  .stat-release-link:hover .stat-release-project,
  .stat-release-link:focus-visible .stat-release-project {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .stat-release-project {
    font-size: 0.75rem;
    color: var(--fg);
    font-weight: 600;
  }

  .pillar-tabs {
    display: flex;
    gap: 0.35rem;
  }

  .pillar-tab {
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--muted);
    padding: 0.2rem 0.55rem;
    font-size: 0.75rem;
    cursor: pointer;
  }

  .pillar-tab[aria-selected='true'] {
    border-color: var(--accent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, var(--bg));
  }

  .pillar-list {
    padding: 1.1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  [data-pillars][data-enhanced='true'] .pillar-card[data-active='false'] {
    display: none;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .pillar-code {
    color: var(--accent);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pillar-title {
    font-size: 1.4rem;
    color: var(--fg);
  }

  .pillar-formula {
    display: block;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--accent) 7%, var(--bg));
    color: var(--fg);
    font-size: 0.75rem;
  }

  .pillar-summary {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .pillar-projects {
    list-style: none;
    margin: 0;
    padding: 0.55rem 0 0;
    border-top: 1px dashed var(--rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    font-size: 0.75rem;
  }

  .pillar-projects a {
    color: var(--fg);
    text-decoration: none;
  }

  .pillar-projects a:hover,
  .pillar-projects a:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 60rem) {
    .inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 38rem) {
    .profile-hero {
      grid-template-columns: 1fr;
    }

    .portrait-frame {
      width: 9.5rem;
      height: 11rem;
    }

    .topbar-icons {
      border-left: 0;
      border-right: 0;
      padding: 0;
    }

    .telemetry-grid {
      grid-template-columns: 1fr;
    }

    .stat {
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }

    .stat:last-child {
      border-bottom: 0;
    }
  }
</style>
