---
import LocaleToggle from './LocaleToggle.astro';
import type { Locale } from '../lib/i18n';
import { UI } from '../lib/ui-strings';

interface Props {
  locale: Locale;
  pathname: string;
}

const { locale, pathname } = Astro.props;
const t = UI[locale];

// O bonequinho segura o lugar até a fotografia existir. O efeito de
// quadrados de luz (Plano 6) entra por cima desta mesma imagem.
const PORTRAIT_SRC = '/specimen/placeholder.svg';
---

<header class="stage">
  <div class="inner">
    <div class="copy">
      <LocaleToggle current={locale} pathname={pathname} />
      <p class="name">{t.name}</p>
      <h1>{t.thesis}</h1>
      <p class="intro">{t.intro}</p>
    </div>
    <figure class="portrait">
      <img src={PORTRAIT_SRC} alt={t.portraitAlt} width="400" height="500" />
    </figure>
  </div>
</header>

<style>
  .stage {
    border-bottom: 1px solid var(--rule);
  }

  .inner {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(3rem, 2rem + 5vw, 7rem) 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .copy {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .name {
    color: var(--accent);
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(2.75rem, 1.5rem + 5vw, 6rem);
  }

  .intro {
    color: var(--muted);
    max-width: 30rem;
  }

  .portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 22rem);
  }

  .portrait img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--rule);
  }

  @media (max-width: 40rem) {
    .inner {
      grid-template-columns: 1fr;
    }

    .portrait {
      justify-self: start;
      width: min(100%, 16rem);
    }
  }
</style>
