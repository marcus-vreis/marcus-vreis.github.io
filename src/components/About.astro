---
import type { Locale } from '../lib/i18n';
import { UI } from '../lib/ui-strings';

interface Props {
  locale: Locale;
  research: { title: string; tagline: string; href: string }[];
}

const { locale, research } = Astro.props;
const t = UI[locale];
---

<section id="sobre" aria-labelledby="sobre-title">
  <h2 id="sobre-title">{t.aboutHeading}</h2>
  {t.aboutBody.map((paragraph) => <p>{paragraph}</p>)}

  {research.length > 0 && (
    <>
      <h3>{t.researchHeading}</h3>
      <ul class="research">
        {research.map((item) => (
          <li>
            <a href={item.href}>{item.title}</a>
            <span>{item.tagline}</span>
          </li>
        ))}
      </ul>
    </>
  )}

  <h3>{t.contactHeading}</h3>
  <ul class="contact">
    {t.contact.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
  </ul>
</section>

<style>
  section {
    max-width: 72rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 2rem + 3vw, 5rem) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  section > * {
    max-width: 46rem;
  }

  p {
    color: var(--muted);
    max-width: 36rem;
  }

  h3 {
    font-size: 1.5rem;
    margin-top: 1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .research li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .research span {
    color: var(--muted);
    font-size: 0.875rem;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  a {
    border-bottom: 1px solid var(--accent);
    text-decoration: none;
    align-self: start;
  }
</style>
