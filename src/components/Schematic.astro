---
import type { Locale } from '../lib/i18n';
import { UI, type CharacterId } from '../lib/ui-strings';

interface Props {
  character: CharacterId;
  locale: Locale;
  variant?: 'card' | 'detail';
}

const { character, locale, variant = 'card' } = Astro.props;
const t = UI[locale];
const spec = t.schematics[character];
const [s1, s2, s3] = spec.stages;
---

<div class:list={['schematic', `schematic--${variant}`]}>
  <div class="schematic-bar tabular">
    <span class="schematic-code">{spec.code}</span>
    <span class="schematic-metric">{spec.metric}</span>
  </div>

  <div class="schematic-canvas" aria-hidden="true">
    <svg viewBox="0 0 360 128" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
      <defs>
        <pattern id={`grid-${character}-${variant}`} width="16" height="16" patternUnits="userSpaceOnUse">
          <path d="M 16 0 L 0 0 0 16" stroke="currentColor" stroke-opacity="0.07" stroke-width="0.75" />
        </pattern>
      </defs>
      <rect width="360" height="128" fill={`url(#grid-${character}-${variant})`} />

      {character === 'lente' && (
        <g class="diag">
          <rect x="14" y="34" width="66" height="60" rx="2" class="box" />
          <line x1="22" y1="48" x2="64" y2="48" class="accent-stroke" />
          <line x1="22" y1="58" x2="70" y2="58" class="muted-stroke" />
          <line x1="22" y1="68" x2="56" y2="68" class="muted-stroke" />
          <line x1="22" y1="78" x2="68" y2="78" class="muted-stroke" />

          <path d="M 80 64 L 132 28 M 80 64 L 132 46 M 80 64 L 132 64 M 80 64 L 132 82 M 80 64 L 132 100" class="flow-line" />

          <circle cx="172" cy="64" r="36" class="ring" />
          <circle cx="172" cy="64" r="22" class="accent-ring" />
          <circle cx="172" cy="64" r="7" class="accent-fill" />
          <circle cx="172" cy="28" r="3.5" class="accent-fill" />
          <circle cx="203" cy="46" r="3.5" class="accent-fill" />
          <circle cx="203" cy="82" r="3.5" class="accent-fill" />
          <circle cx="172" cy="100" r="3.5" class="accent-fill" />
          <circle cx="141" cy="46" r="3.5" class="accent-fill" />

          <path d="M 208 64 L 254 64" class="flow-line" />

          <rect x="254" y="26" width="92" height="76" rx="2" class="box" />
          <line x1="274" y1="84" x2="274" y2="44" class="muted-stroke" />
          <line x1="269" y1="44" x2="279" y2="44" class="accent-stroke" />
          <line x1="269" y1="84" x2="279" y2="84" class="accent-stroke" />
          <circle cx="274" cy="62" r="3.5" class="accent-fill" />

          <line x1="300" y1="78" x2="300" y2="38" class="muted-stroke" />
          <line x1="295" y1="38" x2="305" y2="38" class="accent-stroke" />
          <line x1="295" y1="78" x2="305" y2="78" class="accent-stroke" />
          <circle cx="300" cy="55" r="3.5" class="accent-fill" />

          <line x1="326" y1="72" x2="326" y2="34" class="muted-stroke" />
          <line x1="321" y1="34" x2="331" y2="34" class="accent-stroke" />
          <line x1="321" y1="72" x2="331" y2="72" class="accent-stroke" />
          <circle cx="326" cy="50" r="3.5" class="accent-fill" />
        </g>
      )}

      {character === 'custodia' && (
        <g class="diag">
          <rect x="14" y="28" width="118" height="72" rx="2" class="box" />
          <rect x="28" y="40" width="32" height="48" class="muted-box" />
          <rect x="66" y="64" width="24" height="24" class="accent-box" />
          <path d="M 60 64 L 66 76" class="accent-stroke" />
          <polygon points="104,48 124,36 124,90 104,78" class="ring" />

          <line x1="176" y1="12" x2="176" y2="116" class="seam-line" />
          <circle cx="176" cy="64" r="5" class="accent-fill" />

          <ellipse cx="242" cy="68" rx="44" ry="26" class="ring" />
          <ellipse cx="242" cy="68" rx="22" ry="13" class="accent-ring" />
          <circle cx="242" cy="68" r="4" class="accent-fill" />
          <circle cx="230" cy="62" r="3" class="fg-fill" />
          <path d="M 250 66 L 280 44" class="flow-line" />
          <circle cx="282" cy="42" r="3.5" class="accent-fill" />

          <rect x="300" y="30" width="46" height="68" rx="2" class="box" />
          <rect x="307" y="38" width="32" height="12" class="accent-box" />
          <rect x="307" y="56" width="32" height="12" class="muted-box" />
          <rect x="307" y="74" width="32" height="12" class="muted-box" />
        </g>
      )}

      {character === 'fliperama' && (
        <g class="diag">
          <rect x="14" y="42" width="54" height="44" rx="2" class="box" />
          <rect x="22" y="50" width="38" height="28" class="muted-box" />
          <path d="M 68 54 L 116 34" class="flow-line" />
          <path d="M 68 74 L 116 92" class="muted-stroke" />

          <rect x="116" y="18" width="130" height="40" rx="2" class="accent-box" />
          <rect x="126" y="26" width="20" height="24" class="box" />
          <rect x="152" y="23" width="22" height="27" class="accent-ring" />
          <rect x="180" y="26" width="20" height="24" class="box" />
          <circle cx="163" cy="23" r="3.5" class="accent-fill" />
          <path d="M 212 26 L 236 26 L 236 50 L 212 50 Z" class="ring" />
          <path d="M 216 44 L 224 44 L 224 32 L 232 32" class="accent-stroke" />

          <rect x="116" y="72" width="130" height="38" rx="2" class="box" />
          <circle cx="142" cy="91" r="10" class="ring" />
          <line x1="162" y1="86" x2="232" y2="86" class="muted-stroke" />
          <line x1="162" y1="96" x2="214" y2="96" class="accent-stroke" />

          <path d="M 246 38 L 284 60" class="flow-line" />
          <path d="M 246 90 L 284 68" class="flow-line" />

          <rect x="284" y="42" width="62" height="44" rx="8" class="box" />
          <path d="M 302 56 L 302 72 M 294 64 L 310 64" class="accent-stroke" />
          <circle cx="328" cy="58" r="3.5" class="accent-fill" />
          <circle cx="336" cy="66" r="3.5" class="ring" />
        </g>
      )}

      {character === 'estacao' && (
        <g class="diag">
          <circle cx="32" cy="32" r="10" class="ring" />
          <circle cx="32" cy="64" r="10" class="accent-ring" />
          <circle cx="32" cy="96" r="10" class="ring" />
          <circle cx="32" cy="64" r="3.5" class="accent-fill" />

          <path d="M 42 32 L 96 54 M 42 64 L 96 64 M 42 96 L 96 74" class="flow-line" />

          <rect x="96" y="36" width="76" height="56" rx="2" class="box" />
          <rect x="104" y="45" width="14" height="38" class="accent-box" />
          <rect x="123" y="45" width="14" height="38" class="accent-box" />
          <rect x="142" y="45" width="14" height="38" class="muted-box" />

          <path d="M 172 64 L 208 64" class="flow-line" />

          <circle cx="232" cy="64" r="24" class="accent-ring" />
          <circle cx="232" cy="64" r="12" class="ring" />
          <circle cx="232" cy="64" r="4" class="accent-fill" />

          <path d="M 256 54 L 292 40 M 256 74 L 292 88" class="flow-line" />
          <rect x="292" y="26" width="54" height="28" rx="2" class="accent-box" />
          <rect x="292" y="74" width="54" height="28" rx="2" class="box" />
        </g>
      )}

      {character === 'scanner' && (
        <g class="diag">
          <rect x="16" y="28" width="72" height="72" rx="2" class="box" />
          <line x1="40" y1="28" x2="40" y2="100" class="muted-stroke" />
          <line x1="64" y1="28" x2="64" y2="100" class="muted-stroke" />
          <line x1="16" y1="52" x2="88" y2="52" class="muted-stroke" />
          <line x1="16" y1="76" x2="88" y2="76" class="muted-stroke" />
          <rect x="40" y="52" width="24" height="24" class="accent-box" />

          <path d="M 88 64 L 130 64" class="flow-line" />

          <circle cx="168" cy="64" r="34" class="ring" />
          <circle cx="168" cy="64" r="21" class="accent-ring" />
          <circle cx="168" cy="64" r="8" class="accent-fill" />
          <line x1="130" y1="64" x2="206" y2="64" class="muted-stroke" />
          <line x1="168" y1="26" x2="168" y2="102" class="muted-stroke" />

          <path d="M 206 64 L 244 64" class="flow-line" />

          <rect x="244" y="28" width="100" height="72" rx="2" class="box" />
          <path d="M 254 88 Q 272 38 286 80 T 320 44 Q 330 68 336 88" class="accent-stroke" />
          <line x1="296" y1="32" x2="296" y2="94" class="seam-line" />
        </g>
      )}

      {character === 'cafeteira' && (
        <g class="diag">
          <rect x="16" y="30" width="68" height="68" rx="2" class="box" />
          <ellipse cx="50" cy="64" rx="18" ry="24" class="accent-ring" />
          <path d="M 50 42 Q 44 64 50 86" class="accent-stroke" />

          <path d="M 84 64 L 122 64" class="flow-line" />

          <rect x="122" y="28" width="72" height="72" rx="2" class="box" />
          <line x1="158" y1="28" x2="158" y2="100" class="muted-stroke" />
          <line x1="122" y1="64" x2="194" y2="64" class="muted-stroke" />
          <rect x="126" y="32" width="28" height="28" class="accent-box" />
          <circle cx="140" cy="46" r="4" class="accent-fill" />

          <path d="M 194 44 L 238 34 M 194 64 L 238 64 M 194 84 L 238 94" class="flow-line" />

          <rect x="238" y="22" width="44" height="22" rx="2" class="box" />
          <rect x="238" y="53" width="44" height="22" rx="2" class="accent-box" />
          <rect x="238" y="84" width="44" height="22" rx="2" class="box" />

          <path d="M 282 33 L 318 64 M 282 64 L 318 64 M 282 95 L 318 64" class="flow-line" />
          <circle cx="328" cy="64" r="14" class="accent-ring" />
          <circle cx="328" cy="64" r="5" class="accent-fill" />
        </g>
      )}

      {character === 'plotter' && (
        <g class="diag">
          <rect x="16" y="28" width="76" height="72" rx="2" class="box" />
          <polygon points="54,38 74,54 66,86 42,86 34,54" class="accent-ring" />
          <circle cx="54" cy="64" r="3" class="accent-fill" />

          <path d="M 92 64 L 136 64" class="flow-line" />

          <rect x="136" y="20" width="208" height="88" rx="2" class="box" />
          <line x1="168" y1="100" x2="316" y2="28" class="seam-line" />

          <circle cx="182" cy="46" r="4" class="ring" />
          <circle cx="204" cy="38" r="4" class="ring" />
          <circle cx="192" cy="66" r="4" class="ring" />

          <circle cx="238" cy="62" r="5.5" class="accent-fill" />
          <circle cx="238" cy="62" r="28" class="accent-ring" />

          <line x1="238" y1="62" x2="256" y2="48" class="accent-stroke" />
          <line x1="238" y1="62" x2="262" y2="74" class="accent-stroke" />
          <line x1="238" y1="62" x2="218" y2="76" class="accent-stroke" />

          <circle cx="256" cy="48" r="4" class="accent-fill" />
          <circle cx="262" cy="74" r="4" class="accent-fill" />
          <circle cx="218" cy="76" r="4" class="accent-fill" />
          <circle cx="304" cy="82" r="4" class="fg-fill" />
          <circle cx="318" cy="60" r="4" class="fg-fill" />
        </g>
      )}

      {character === 'esteira' && (
        <g class="diag">
          <rect x="16" y="24" width="128" height="80" rx="2" class="box" />
          <rect x="28" y="76" width="10" height="18" class="muted-box" />
          <rect x="44" y="64" width="10" height="30" class="muted-box" />
          <rect x="60" y="50" width="10" height="44" class="accent-box" />
          <rect x="76" y="70" width="10" height="24" class="muted-box" />
          <rect x="92" y="40" width="10" height="54" class="muted-box" />
          <rect x="108" y="32" width="10" height="62" class="accent-box" />
          <circle cx="65" cy="42" r="3" class="accent-fill" />
          <circle cx="113" cy="26" r="3" class="accent-fill" />

          <path d="M 144 64 L 184 64" class="flow-line" />

          <rect x="184" y="24" width="160" height="80" rx="2" class="box" />
          <path d="M 198 92 Q 218 86 242 32" class="seam-line" />
          <path d="M 198 92 C 236 88 284 74 332 54" class="accent-stroke" />
          <circle cx="230" cy="84" r="3" class="accent-fill" />
          <circle cx="280" cy="72" r="3" class="accent-fill" />
          <circle cx="332" cy="54" r="3.5" class="accent-fill" />
        </g>
      )}

      {character === 'nevoeiro' && (
        <g class="diag">
          <rect x="14" y="28" width="76" height="72" rx="2" class="box" />
          <line x1="24" y1="44" x2="80" y2="44" class="muted-stroke" />
          <line x1="28" y1="58" x2="76" y2="58" class="muted-stroke" />
          <line x1="22" y1="72" x2="82" y2="72" class="muted-stroke" />
          <rect x="34" y="48" width="36" height="28" class="accent-ring" />

          <path d="M 90 48 L 136 34" class="muted-stroke" />
          <path d="M 90 78 L 136 88" class="flow-line" />

          <rect x="136" y="18" width="108" height="34" rx="2" class="box" />
          <line x1="146" y1="26" x2="234" y2="44" class="seam-line" />
          <line x1="146" y1="44" x2="234" y2="26" class="seam-line" />

          <rect x="136" y="68" width="108" height="42" rx="2" class="accent-box" />
          <rect x="148" y="76" width="28" height="24" class="ring" />
          <rect x="184" y="76" width="28" height="24" class="accent-ring" />
          <circle cx="226" cy="88" r="5" class="accent-fill" />

          <path d="M 244 88 L 282 64" class="flow-line" />
          <rect x="282" y="38" width="64" height="52" rx="2" class="box" />
          <line x1="294" y1="76" x2="312" y2="58" class="muted-stroke" />
          <line x1="312" y1="58" x2="334" y2="48" class="accent-stroke" />
          <circle cx="334" cy="48" r="4" class="accent-fill" />
        </g>
      )}
    </svg>
  </div>

  <div class="schematic-stages tabular" aria-hidden="true">
    <span>01 · {s1}</span>
    <span>02 · {s2}</span>
    <span>03 · {s3}</span>
  </div>

  <p class="schematic-formula tabular">{spec.formula}</p>

  {variant === 'detail' && (
    <p class="schematic-invariant">
      <strong class="tabular">{t.invariantLabel}:</strong> {spec.invariant}
    </p>
  )}
</div>

<style>
  .schematic {
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--fg) 2.5%, var(--bg));
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .schematic-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--fg) 4%, var(--bg));
  }

  .schematic-code {
    color: var(--accent);
    font-weight: 600;
  }

  .schematic-metric {
    color: var(--muted);
    text-align: right;
  }

  .schematic-canvas {
    position: relative;
    line-height: 0;
    padding: 0.375rem 0.5rem;
  }

  svg {
    width: 100%;
    height: auto;
    display: block;
    color: var(--fg);
  }

  .box {
    fill: color-mix(in srgb, var(--fg) 3%, var(--bg));
    stroke: var(--rule);
    stroke-width: 1.25;
  }

  .muted-box {
    fill: color-mix(in srgb, var(--muted) 15%, var(--bg));
    stroke: var(--muted);
    stroke-width: 1;
  }

  .accent-box {
    fill: color-mix(in srgb, var(--accent) 14%, var(--bg));
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .ring {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-dasharray: 3 3;
  }

  .accent-ring {
    fill: color-mix(in srgb, var(--accent) 10%, transparent);
    stroke: var(--accent);
    stroke-width: 1.5;
  }

  .accent-fill {
    fill: var(--accent);
  }

  .fg-fill {
    fill: var(--fg);
  }

  .accent-stroke {
    stroke: var(--accent);
    stroke-width: 1.75;
    stroke-linecap: round;
    fill: none;
  }

  .muted-stroke {
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-linecap: round;
    fill: none;
  }

  .flow-line {
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-dasharray: 4 3;
    fill: none;
  }

  .seam-line {
    stroke: var(--muted);
    stroke-width: 1.25;
    stroke-dasharray: 2 3;
    fill: none;
  }

  .schematic-stages {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .schematic-stages span {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .schematic-formula {
    padding: 0.45rem 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--fg);
    background: color-mix(in srgb, var(--accent) 6%, var(--bg));
  }

  .schematic-invariant {
    padding: 0.65rem 0.75rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .schematic-invariant strong {
    color: var(--accent);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .schematic-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.15rem;
    }

    .schematic-stages {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
